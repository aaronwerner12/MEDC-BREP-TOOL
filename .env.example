# Copy to .env.local and fill in. Set the same vars in Vercel
# (Project -> Settings -> Environment Variables), including CRON_SECRET.

# Neon Postgres connection string (pooled connection is fine for serverless)
DATABASE_URL=

# Anthropic API key. OPTIONAL. Signal scoring is now rules-based and needs no
# key. This only powers the opt-in AI extras: company profiles, briefings, the
# web news scan, and employer discovery. Leave blank to run the desk with zero
# per-use cost.
ANTHROPIC_API_KEY=

# Optional kill switch for the AI extras while keeping the key configured. Set
# to off (or false / 0 / no) to disable profiles, briefings, and news without
# removing ANTHROPIC_API_KEY. Leave blank to keep them on when a key is present.
ENABLE_AI_FEATURES=

# OPTIONAL free profile sources. Company profiles resolve free-first from a
# chain: Wikidata (no key), then these if set, then the company website, then
# AI. Each is skipped when its key is blank.

# OpenCorporates free API token: legal name, registered address, officers, and
# status for private firms Wikidata misses. Request one at
# https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=

# Google Knowledge Graph Search API key (a standard free Google Cloud API key
# with the Knowledge Graph Search API enabled): short description + website for
# businesses in Google's graph. https://console.cloud.google.com/apis/library/kgsearch.googleapis.com
GOOGLE_KG_API_KEY=

# Resend API key, used by the daily digest
RESEND_API_KEY=

# Where the morning digest is sent
BRE_LEAD_EMAIL=

# Shared secret. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Cron and inbound routes authorize against it. Never expose client-side.
CRON_SECRET=
